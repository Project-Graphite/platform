{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Graphite deploy values",
  "type": "object",
  "additionalProperties": false,
  "required": ["core", "slug", "services"],
  "properties": {
    "core": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"},
    "name": {"type": "string"},
    "host": {"type": "string"},
    "enabled": {"type": "boolean"},
    "secrets": {"$ref": "#/definitions/names"},
    "sleep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after": {"$ref": "#/definitions/duration"},
        "wake": {"type": "string", "pattern": "^(@every [0-9]+[smh]|[^ ]+( [^ ]+){4})$"},
        "wakeFor": {"$ref": "#/definitions/duration"}
      },
      "dependencies": {"wake": ["after"], "wakeFor": ["wake"]}
    },
    "tags": {"type": "object", "additionalProperties": {"type": "string"}},
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/definitions/service"}
    }
  },
  "definitions": {
    "duration": {"type": "string", "pattern": "^[0-9]+(s|m|h)$"},
    "memory": {"type": "string", "pattern": "^[0-9]+[MG]$"},
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "resources"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "entrypoint": {"$ref": "#/definitions/strings"},
        "command": {"$ref": "#/definitions/strings"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "public": {"type": "boolean"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "dependsOn": {
          "type": "object",
          "additionalProperties": {"enum": ["healthy", "started", "completed"]}
        },
        "volumes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[^:]+:/[^:]*(:ro)?$"}},
        "files": {"type": "object", "propertyNames": {"pattern": "^/"}, "additionalProperties": {"type": "string"}},
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test"],
          "properties": {
            "test": {"$ref": "#/definitions/strings"},
            "interval": {"$ref": "#/definitions/duration"},
            "timeout": {"$ref": "#/definitions/duration"},
            "retries": {"type": "integer", "minimum": 1},
            "startPeriod": {"$ref": "#/definitions/duration"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpus", "memory"],
          "properties": {
            "cpus": {"type": ["string", "number"]},
            "memory": {"$ref": "#/definitions/memory"},
            "reserve": {"$ref": "#/definitions/memory"}
          }
        },
        "once": {"type": "boolean"},
        "init": {"type": "boolean"},
        "noNewPrivileges": {"type": "boolean"},
        "stopGracePeriod": {"$ref": "#/definitions/duration"}
      }
    }
  }
}
