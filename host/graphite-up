#!/bin/sh
set -eu

name=$1
cd "/srv/graphite/$name"
env=/etc/graphite/$name.env
if [ ! -f "$env" ]; then
  env=secrets.env
  touch secrets.env
  chmod 600 secrets.env
fi
set --
if [ -f values ]; then
  set -- --env-file values
fi
docker compose -p "$name" "$@" --env-file "$env" up -d --wait --wait-timeout 300 --remove-orphans
touch .applied
docker image prune -af --filter until=24h >/dev/null || echo "graphite-up: image prune failed" >&2
