{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/project-graphite/platform/blob/main/schema/project.schema.json",
  "title": "Project Graphite registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "kind", "name", "summary", "repo", "owner", "authors", "status", "deploy"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
      "description": "URL segment for this entry. Matches the repository name unless parent is set."
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
      "description": "Epic that contains this project."
    },
    "kind": {"enum": ["project", "epic"]},
    "name": {"type": "string", "minLength": 2, "maxLength": 60},
    "summary": {"type": "string", "minLength": 20, "maxLength": 240},
    "tags": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]*$"}
    },
    "repo": {"type": "string", "pattern": "^project-graphite/[A-Za-z0-9._-]+$"},
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "description": "Handle of the person responsible for maintaining this project."
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"}
    },
    "status": {"enum": ["live", "wip", "archived", "source-only"]},
    "listed": {
      "type": "boolean",
      "description": "Show this entry on the portfolio. Platform pieces set it to false."
    },
    "pinned": {
      "type": "boolean",
      "description": "Always show this entry on the portfolio home page, ahead of the others."
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*[.][.])[A-Za-z0-9._/-]+$"},
      "description": "Repository folders that belong to this project. The changelog records commits touching them; set it for each project inside an epic so its versions can be cut automatically."
    },
    "releases": {
      "enum": ["auto", "manual"],
      "description": "auto (default): the daily changelog sync tags a new version when user-facing commits land. manual: only version tags pushed by people are recorded."
    },
    "showcase": {"$ref": "#/$defs/showcase"},
    "deploy": {"$ref": "#/$defs/deploy"}
  },
  "$defs": {
    "showcase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "approach", "outcome", "contributions"],
      "properties": {
        "problem": {"type": "string", "minLength": 20, "maxLength": 500},
        "approach": {"type": "string", "minLength": 20, "maxLength": 700},
        "outcome": {"type": "string", "minLength": 20, "maxLength": 500},
        "contributions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["github", "summary"],
            "properties": {
              "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"},
              "summary": {"type": "string", "minLength": 20, "maxLength": 300}
            }
          }
        }
      }
    },
    "deploy": {
      "oneOf": [
        {"$ref": "#/$defs/composeDeploy"},
        {"$ref": "#/$defs/pagesDeploy"},
        {"$ref": "#/$defs/noneDeploy"}
      ]
    },
    "composeDeploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "host", "source"],
      "properties": {
        "kind": {"const": "compose"},
        "host": {"$ref": "#/$defs/host"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "service", "port"],
          "properties": {
            "file": {"type": "string", "pattern": "^(?!/)(?!.*[.][.])[A-Za-z0-9._/-]+[.]ya?ml$"},
            "service": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
        }
      }
    },
    "pagesDeploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "host", "source"],
      "properties": {
        "kind": {"const": "pages"},
        "host": {"$ref": "#/$defs/host"},
        "source": {
          "type": "object",
          "required": ["directory", "output"],
          "additionalProperties": false,
          "properties": {
            "directory": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "output": {"type": "string", "minLength": 1},
            "command": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "noneDeploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "none"}}
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?[.]project-graphite[.]com$|^project-graphite[.]com$"
    }
  }
}
